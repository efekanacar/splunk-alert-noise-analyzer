# CLI only. The browser UI requires explicit username/password or token login.
# Same Ubuntu machine as Splunk. For a remote VM: https://192.168.3.131:8089
SPLUNK_BASE_URL=https://localhost:8089
SPLUNK_TOKEN=
SPLUNK_USERNAME=
SPLUNK_PASSWORD=
SPLUNK_VERIFY_TLS=true
# Optional path to a trusted CA bundle (preferred for lab certificates).
SPLUNK_CA_BUNDLE=
